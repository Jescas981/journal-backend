DATA_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
FIRESTORE_DATABASE=YOUR_DATABASE_ID
STORAGE_BUCKET=YOUR_BUCKET_NAME
JOURNAL_NAMESPACE=personal
APP_ORIGIN=https://REEMPLAZAR_CON_URL_PUBLICA
# Google OAuth and CALENDAR_TOKEN_KEY must be the existing values, injected via Secret Manager.
# Never generate a replacement CALENDAR_TOKEN_KEY when importing encrypted refresh tokens.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_EMAIL=user@example.com
# CALENDAR_TOKEN_KEY=
